{
  "name": "@irnbrdi/meta-ads-mcp",
  "version": "1.3.0",
  "mcpName": "io.github.irnbrdi/meta-ads",
  "description": "MCP server for Meta Marketing API v25.0 - 135 tools for Facebook and Instagram ad campaign management (HTTP transport for remote hosting)",
  "type": "module",
  "bin": {
    "meta-ads-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "dev": "tsx src/http.ts",
    "dev:stdio": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "meta",
    "facebook",
    "instagram",
    "ads",
    "marketing",
    "advertising",
    "campaign"
  ],
  "license": "MIT",
  "author": "mikusnuz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irnbrdi/meta-ads-mcp.git"
  },
  "homepage": "https://github.com/irnbrdi/meta-ads-mcp#readme",
  "bugs": {
    "url": "https://github.com/irnbrdi/meta-ads-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
